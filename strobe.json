{
  "$schema": "./node_modules/@hona/strobe/schema/strobe.v1.json",
  // The bench starts `axonometric serve` itself, from each variant's own
  // packages/cli/dist, so a variant is the CLI bundle (which embeds the
  // editor page) and nothing is served from here.
  "build": {
    "command": "bun run build",
    "output": "packages/cli/dist"
  }
}
