{
  "name": "axonometric-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/tsgo": "^0.70.0",
      "@oxlint/plugins": "^1.94.0",
      "@shadcn/lint": "^0.2.5",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.5.1",
      "eslint-plugin-turbo": "^2.11.11",
      "lefthook": "^2.2.2",
      "oxfmt": "^0.78.0",
      "oxlint": "^1.94.0",
      "oxlint-tsgolint": "7.0.2007",
      "playwright": "1.64.1",
      "react": "^19.3.1",
      "react-doctor": "^0.9.22",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.5",
      "tsdown": "^0.23.4",
      "turbo": "^2.11.11",
      "tw-animate-css": "^1.4.0",
      "typescript": "^7.0.2",
      "vite": "^8.3.5",
      "vite-plugin-singlefile": "^2.3.4",
      "vitest": "^5.1.0"
    },
    "catalogs": {
      "effect": {
        "@effect/platform-node": "4.1.4",
        "@effect/vitest": "4.1.4",
        "effect": "4.1.4"
      }
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint --tsrs && lefthook install",
    "build": "turbo run build",
    "test": "node scripts/with-test-lock.ts -- turbo run test //#test:scripts",
    "test:scripts": "node --test scripts/*.test.ts",
    "perf": "node scripts/with-test-lock.ts -- strobe bench perf/drag.bench.ts",
    "ox": "turbo run lint format typecheck",
    "ox:fix": "turbo run typecheck format:fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "react-doctor": "react-doctor --project @axonometric/editor,@axonometric/ui --blocking warning --no-score --yes"
  },
  "devDependencies": {
    "@axonometric/config": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@hona/strobe": "^0.44.0",
    "@nkzw/oxlint-config": "3.0.0",
    "@oxlint/plugins": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:effect",
    "eslint-plugin-turbo": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react-doctor": "catalog:",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.4"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ]
}
