{
  "name": "axonometric-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@effect/tsgo": "^0.63.0",
      "@oxlint/plugins": "^1.90.0",
      "@shadcn/lint": "^0.2.3",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.5.1",
      "eslint-plugin-turbo": "^2.11.10",
      "lefthook": "^2.2.2",
      "oxfmt": "^0.75.0",
      "oxlint": "^1.90.0",
      "oxlint-tsgolint": "^7.0.2005",
      "playwright": "1.59.1",
      "react": "^19.3.1",
      "react-doctor": "^0.9.18",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.3",
      "tsdown": "^0.23.4",
      "turbo": "^2.11.10",
      "tw-animate-css": "^1.4.0",
      "typescript": "^7.0.2",
      "vite": "^8.3.5",
      "vite-plugin-singlefile": "^2.3.4",
      "vitest": "^5.0.5"
    },
    "catalogs": {
      "effect": {
        "@effect/platform-node": "4.1.0",
        "@effect/vitest": "4.1.0",
        "effect": "4.1.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint && lefthook install",
    "build": "turbo run build",
    "test": "turbo run test",
    "ox": "turbo run lint format typecheck",
    "ox:fix": "turbo run typecheck format:fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "react-doctor": "react-doctor packages/editor --blocking warning --no-score --yes"
  },
  "devDependencies": {
    "@axonometric/config": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:effect",
    "eslint-plugin-turbo": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react-doctor": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ]
}
