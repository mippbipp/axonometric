  },
  "license": "MIT",
  "author": "mippbipp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mippbipp/axonometric.git"
  },
  "bin": {
    "axonometric": "dist/bin.mjs"
  },
  "files": [
    "dist/bin.mjs"
  ],
  "type": "module",
  "scripts": {
