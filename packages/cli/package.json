    "@effect/platform-node": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:effect",
    "playwright": "catalog:",
    "postject": "1.0.0-alpha.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
