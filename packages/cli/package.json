{
  "name": "axonometric",
  "version": "0.1.1",
  "description": "Editable architecture maps built with an AI agent",
  "keywords": [
    "ai-agent",
    "architecture",
    "cli",
    "diagram",
    "isometric"
  ],
  "homepage": "https://github.com/mippbipp/axonometric#readme",
